{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TermiNote",
  "version": "0.8.2",
  "identifier": "com.seanshaffer.terminote",
  "build": {
    "beforeDevCommand": "cd ../ui && dx serve --platform web --addr 127.0.0.1:8080",
    "devUrl": "http://127.0.0.1:8080",
    "beforeBuildCommand": "cd ../ui && dx build --platform web --release",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TermiNote",
        "width": 720,
        "height": 760,
        "minWidth": 440,
        "minHeight": 420,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../windows/runner/resources/app_icon.ico"]
  }
}

